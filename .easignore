# Root .easignore (for Monorepo EAS Build)

# Dependencies & caches
node_modules
.turbo
.cache
dist
build
coverage

# Backend and unneeded apps for mobile build
apps/api
docs
.agents
.vscode
.git

# Environment files
.env
.env.*
!.env.example

# Temporary / logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Always allow mobile assets and configs
!apps/mobile/google-services.json
!apps/mobile/app.json
!apps/mobile/eas.json
