# ==========================================
# Aurora Mobile App - Environment Configuration (.env.example)
# ==========================================
# Ghi chú: Với Expo SDK 57+, tất cả biến môi trường được đọc phía client
# bắt buộc phải có tiền tố "EXPO_PUBLIC_"

# ------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------
# - iOS Simulator / Web: http://localhost:3000/api/v1
# - Android Emulator:    http://10.0.2.2:3000/api/v1
# - Thiết bị thật (Expo Go qua Wi-Fi): http://<IP_MÁY_TÍNH_CỦA_BẠN>:3000/api/v1 (VD: http://192.168.1.15:3000/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ------------------------------------------
# 2. App Environment Mode
# ------------------------------------------
# Giá trị: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------
# 3. OAuth & Social Login (Tùy chọn)
# ------------------------------------------
# Google OAuth Client IDs (nếu cấu hình trực tiếp từ Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your_ios_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_android_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_google_client_id.apps.googleusercontent.com
