{
  "expo": {
    "name": "Aurora",
    "slug": "aurora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aurora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aurora.diary",
      "infoPlist": {
        "NSCameraUsageDescription": "Aurora needs access to your camera to take daily moments.",
        "NSPhotoLibraryUsageDescription": "Aurora needs access to your photos to choose avatar and moments."
      }
    },
    "android": {
      "package": "com.aurora.diary",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FDFBF7"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdf46ce7-0a4f-4a02-94c1-635d35fc6482"
      }
    },
    "owner": "huylezz"
  }
}
