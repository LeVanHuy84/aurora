# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurora_db?schema=public"

# Application Config
PORT=3000
NODE_ENV="development"

# JWT Auth Configuration
JWT_SECRET="aurora_super_secret_jwt_key_change_me_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# OAuth Configuration (Optional / Integration)
GOOGLE_CLIENT_ID="your-google-client-id"
APPLE_CLIENT_ID="your-apple-client-id"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Mail Configuration
# Option 1: Resend HTTP API (Recommended for Cloud Deployments like Render / Railway where SMTP ports 587/465 are blocked)
RESEND_API_KEY="re_your_resend_api_key"
MAIL_FROM="Aurora <onboarding@resend.dev>"

# Option 2: SMTP / Gmail (Recommended for Local Dev or VPS where port 587 is open)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

